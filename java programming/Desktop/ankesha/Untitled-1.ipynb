   "source": [
    "l=list(map(int,input(\"Enter:\").split()))\n",
    "l.sort\n",
    "n=l[-1]\n",
    "a=list()\n",
    "for i in range(n+l):\n",
    "    a.append(0)\n",
    "for i in l:\n",
    "        a[i]=i\n",
    "print(a)"
   ]
